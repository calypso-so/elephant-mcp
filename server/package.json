{
  "name": "@calypsohq/elephant-mcp-server",
  "version": "1.3.2",
  "description": "Elephant: PDF AI and docs Q&A as an MCP server. Chat with your PDFs, documents and web pages from Claude, ChatGPT and Cursor, with every answer cited.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "elephant-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elephant",
    "calypso",
    "mcp-server",
    "pdf",
    "pdf-ai",
    "chat-with-pdf",
    "document-qa",
    "rag",
    "retrieval-augmented-generation",
    "citations",
    "knowledge-base",
    "second-brain",
    "claude",
    "claude-code",
    "chatgpt",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Calypso",
  "homepage": "https://www.calypso.so/elephant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calypso-so/elephant-mcp.git",
    "directory": "server"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/stdio.js', '755')\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-http.mjs",
    "lint": "biome check --indent-style=space --indent-width=2 src scripts tests",
    "format": "biome format --write --indent-style=space --indent-width=2 src scripts tests",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run smoke:stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.3.1",
    "jose": "^6.2.17",
    "openai": "^4.20.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
