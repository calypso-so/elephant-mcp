{
  "name": "@calypsohq/elephant-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Elephant by Calypso: hosted MCP server (Streamable HTTP, OAuth) for ChatGPT and other remote MCP clients.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "Calypso",
  "homepage": "https://www.calypso.so/elephant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calypso-so/elephant.git",
    "directory": "server"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-http.mjs",
    "lint": "biome check --indent-style=space --indent-width=2 src scripts tests",
    "format": "biome format --write --indent-style=space --indent-width=2 src scripts tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.3.1",
    "jose": "^6.2.17",
    "openai": "^4.20.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
